    "test:lighthouse:collect": "lhci collect",
    "test:homepage": "playwright test homepage.spec.ts",
    "assets:social": "node scripts/generate-social.mjs",
    "test:technology": "playwright test technology.spec.ts",
    "assets:technology-social": "node scripts/generate-technology-social.mjs",
